# Loaded by prisma7.config.ts for database-package commands.
DATABASE_URL=postgresql://postgres:password@localhost:5432/postgres
# DealFlow360 deliberately avoids an existing public schema by default.
DATABASE_SCHEMA=dealflow360
# Optional. Set 12-128 characters to enable password sign-in for seeded users.
DEMO_PASSWORD=DealFlow360-Demo!2026
# Optional local PostgreSQL example:
# docker run --name my-postgres -e POSTGRES_PASSWORD=password -p 5432:5432 -d postgres
