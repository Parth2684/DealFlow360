  subscriptionPlanId String   @map("subscription_plan_id")
  productName        String   @map("product_name")
  quantity           Decimal  @db.Decimal(19, 4)
  unitPrice          Decimal  @map("unit_price") @db.Decimal(19, 4)
  createdAt          DateTime @default(now()) @map("created_at")
  updatedAt          DateTime @updatedAt @map("updated_at")

  subscription     Subscription     @relation(fields: [subscriptionId], references: [id])
  orderLine        OrderLine        @relation(fields: [orderLineId], references: [id])
  subscriptionPlan SubscriptionPlan @relation(fields: [subscriptionPlanId], references: [id])

  @@map("subscription_items")
}

model BillingSchedule {
  id             String                @id @default(cuid())
