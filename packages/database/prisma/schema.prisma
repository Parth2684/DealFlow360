model Order {
  id               String      @id @default(cuid())
  organizationId   String      @map("organization_id")
  quoteId          String      @map("quote_id")
  quoteVersionId   String      @map("quote_version_id")
  customerAccountId String     @map("customer_account_id")
  orderNumber      String      @map("order_number")
  status           OrderStatus @default(CONFIRMED)
  termsFingerprint String      @map("terms_fingerprint")
  currency         String      @default("USD")
  subtotal         Decimal     @default(0) @db.Decimal(19, 4)
  taxTotal         Decimal     @default(0) @map("tax_total") @db.Decimal(19, 4)
  total            Decimal     @default(0) @db.Decimal(19, 4)
