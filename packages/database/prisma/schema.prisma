  @@unique([approvalRequestId, sequence])
  @@index([organizationId, assigneeId, status])
  @@index([dueAt, status])
  @@map("approval_steps")
}

model ApprovalDecision {
  id                String                 @id @default(cuid())
  organizationId    String                 @map("organization_id")
  approvalRequestId String                 @map("approval_request_id")
  approvalStepId    String                 @map("approval_step_id")
  actorId           String                 @map("actor_id")
  action            ApprovalDecisionAction
  reason            String?
  createdAt         DateTime               @default(now()) @map("created_at")

  approvalRequest ApprovalRequest @relation(fields: [approvalRequestId], references: [id])
  approvalStep    ApprovalStep    @relation(fields: [approvalStepId], references: [id])
  actor           User            @relation(fields: [actorId], references: [id])

  @@index([approvalRequestId, createdAt])
  @@map("approval_decisions")
}

model NegotiationThread {
