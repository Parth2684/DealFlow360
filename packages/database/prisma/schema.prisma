generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

// ─── Enums ───────────────────────────────────────────────────────────────────

enum UserStatus {
  ACTIVE
  INACTIVE
  SUSPENDED
}

enum Role {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  OPERATIONS
  CUSTOMER
}

enum ProductType {
  HARDWARE
  SERVICE
  SUBSCRIPTION
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum TaxBehavior {
  INCLUSIVE
  EXCLUSIVE
}

enum QuoteStage {
  DRAFT
  PENDING_APPROVAL
  READY_TO_SEND
  SENT
  UNDER_NEGOTIATION
  CUSTOMER_ACCEPTED
  CONFIRMED
  REVISION_REQUIRED
  EXPIRED
  CANCELLED
}

enum QuoteVersionStatus {
  DRAFT
  PENDING_APPROVAL
  APPROVED
  SUPERSEDED
  REJECTED
}

enum ApprovalRequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISION_REQUESTED
  SUPERSEDED
}

enum ApprovalStepStatus {
  PENDING
  ACTIVE
  APPROVED
  REJECTED
  REVISION_REQUESTED
  SKIPPED
}

enum ApprovalDecisionAction {
  APPROVE
  REJECT
  REQUEST_REVISION
}

enum NegotiationThreadStatus {
  OPEN
  CLOSED
}

enum ChangeRequestStatus {
  PENDING
  ACCEPTED
  REJECTED
}

enum ChangeRequestType {
  PRICE
  DISCOUNT
  QUANTITY
  TERMS
  COMMENT
}

enum RecommendationInteractionType {
  IMPRESSION
  DISMISS
  ACCEPT
}

enum StockMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SHIPMENT
  ADJUSTMENT
}

enum StockReservationStatus {
  PENDING
  CONFIRMED
  RELEASED
  FULFILLED
}

enum FulfillmentPlanStatus {
  PREVIEW
  ACCEPTED
  OVERRIDDEN
}

enum ShipmentStatus {
  PENDING
  SHIPPED
  DELIVERED
  CANCELLED
}

enum BackorderStatus {
  OPEN
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum OrderStatus {
  CONFIRMED
  ALLOCATING
  FULFILLING
  FULFILLED
  CANCELLED
}

enum SubscriptionStatus {
  ACTIVE
  PAST_DUE
  CANCELLED
  PAUSED
}

enum BillingScheduleStatus {
  PENDING
  GENERATED
  SKIPPED
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum InvoiceType {
  ONE_TIME
  RECURRING
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
}

enum PaymentStatus {
  PENDING
  COMPLETED
  FAILED
  REFUNDED
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CHECK
  OTHER
}

enum ProrationConvention {
  CALENDAR_DAYS
  THIRTY_DAY_MONTH
}

enum SubscriptionInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExportJobStatus {
  PENDING
  PROCESSING
  COMPLETED
  FAILED
}

enum ExportFormat {
  PDF
  XLS
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum DealEventVisibility {
  INTERNAL
  CUSTOMER
  BOTH
}

enum PolicyStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum MagicLinkScope {
  QUOTE
  CUSTOMER
}

// ─── Organization & Access ───────────────────────────────────────────────────

model Organization {
  id           String   @id @default(cuid())
  name         String
  baseCurrency String   @default("USD") @map("base_currency")
  timezone     String   @default("UTC")
  settings     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at")
  updatedAt    DateTime @updatedAt @map("updated_at")

  users              User[]
  roleAssignments    RoleAssignment[]
  salesTeams         SalesTeam[]
  sessions           Session[]
  refreshTokens      RefreshToken[]
  portalIdentities   PortalIdentity[]
  magicLinkTokens    MagicLinkToken[]
  customerAccounts   CustomerAccount[]
  customerTiers      CustomerTier[]
  productCategories  ProductCategory[]
  products           Product[]
  taxes              Tax[]
  priceLists         PriceList[]
  promotions         Promotion[]
  subscriptionPlans  SubscriptionPlan[]
  discountLimits     DiscountLimit[]
  approvalPolicies   ApprovalPolicy[]
  quotes             Quote[]
  warehouses         Warehouse[]
  orders             Order[]
  subscriptions      Subscription[]
  invoices           Invoice[]
  payments           Payment[]
  productAffinities  ProductAffinity[]
  recommendationRules RecommendationRule[]
  dealHealthSnapshots DealHealthSnapshot[]
  alerts             Alert[]
  auditEvents        AuditEvent[]
  dealEvents         DealEvent[]
  outboxEvents       OutboxEvent[]
  idempotencyRecords IdempotencyRecord[]
  exportJobs         ExportJob[]

  @@map("organizations")
}

model User {
  id             String     @id @default(cuid())
  organizationId String     @map("organization_id")
  email          String
  passwordHash   String?    @map("password_hash")
  firstName      String     @map("first_name")
  lastName       String     @map("last_name")
  status         UserStatus @default(ACTIVE)
  revision       Int        @default(0)
  createdAt      DateTime   @default(now()) @map("created_at")
  updatedAt      DateTime   @updatedAt @map("updated_at")

  organization     Organization     @relation(fields: [organizationId], references: [id])
  roleAssignments  RoleAssignment[]
  sessions         Session[]
  refreshTokens    RefreshToken[]
  managedTeams     SalesTeam[]      @relation("TeamManager")
  ownedQuotes      Quote[]          @relation("QuoteOwner")
  approvalSteps    ApprovalStep[]   @relation("StepAssignee")
  approvalDecisions ApprovalDecision[]
  auditEvents      AuditEvent[]
  exportJobs       ExportJob[]

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("users")
}

model RoleAssignment {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  role           Role
  salesTeamId    String?  @map("sales_team_id")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])
  salesTeam    SalesTeam?   @relation(fields: [salesTeamId], references: [id])

  @@unique([organizationId, userId, role, salesTeamId])
  @@index([organizationId, role])
  @@map("role_assignments")
}

model SalesTeam {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  managerId      String?  @map("manager_id")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization     @relation(fields: [organizationId], references: [id])
  manager         User?            @relation("TeamManager", fields: [managerId], references: [id])
  roleAssignments RoleAssignment[]
  customerAccounts CustomerAccount[]

  @@unique([organizationId, name])
  @@map("sales_teams")
}

model Session {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  tokenHash      String   @unique @map("token_hash")
  expiresAt      DateTime @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, userId])
  @@index([expiresAt])
  @@map("sessions")
}

model RefreshToken {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  userId         String   @map("user_id")
  tokenHash      String   @unique @map("token_hash")
  expiresAt      DateTime @map("expires_at")
  revokedAt      DateTime? @map("revoked_at")
  createdAt      DateTime @default(now()) @map("created_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  user         User         @relation(fields: [userId], references: [id])

  @@index([organizationId, userId])
  @@map("refresh_tokens")
}

model PortalIdentity {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  customerContactId String @unique @map("customer_contact_id")
  email          String
  passwordHash   String?  @map("password_hash")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization    Organization    @relation(fields: [organizationId], references: [id])
  customerContact CustomerContact @relation(fields: [customerContactId], references: [id])
  magicLinkTokens MagicLinkToken[]

  @@unique([organizationId, email])
  @@map("portal_identities")
}

model MagicLinkToken {
  id               String         @id @default(cuid())
  organizationId   String         @map("organization_id")
  portalIdentityId String?        @map("portal_identity_id")
  tokenHash        String         @unique @map("token_hash")
  scope            MagicLinkScope
  quoteId          String?        @map("quote_id")
  customerAccountId String?       @map("customer_account_id")
  maxUses          Int            @default(1) @map("max_uses")
  useCount         Int            @default(0) @map("use_count")
  expiresAt        DateTime       @map("expires_at")
  revokedAt        DateTime?      @map("revoked_at")
  createdAt        DateTime       @default(now()) @map("created_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  portalIdentity PortalIdentity? @relation(fields: [portalIdentityId], references: [id])
  quote          Quote?          @relation(fields: [quoteId], references: [id])

  @@index([organizationId, expiresAt])
  @@map("magic_link_tokens")
}

// ─── Customer & Catalog ──────────────────────────────────────────────────────

model CustomerTier {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  priority       Int      @default(0)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  customerAccounts CustomerAccount[]
  priceRules       PriceRule[]
  discountLimits   DiscountLimit[]

  @@unique([organizationId, code])
  @@map("customer_tiers")
}

model CustomerAccount {
  id               String   @id @default(cuid())
  organizationId   String   @map("organization_id")
  name             String
  tierId           String   @map("tier_id")
  salesTeamId      String?  @map("sales_team_id")
  assignedRepId    String?  @map("assigned_rep_id")
  preferredCurrency String  @default("USD") @map("preferred_currency")
  paymentTermsDays Int      @default(30) @map("payment_terms_days")
  creditLimit      Decimal  @default(0) @map("credit_limit") @db.Decimal(19, 4)
  currentExposure  Decimal  @default(0) @map("current_exposure") @db.Decimal(19, 4)
  overdueBalance   Decimal  @default(0) @map("overdue_balance") @db.Decimal(19, 4)
  active           Boolean  @default(true)
  revision         Int      @default(0)
  createdAt        DateTime @default(now()) @map("created_at")
  updatedAt        DateTime @updatedAt @map("updated_at")

  organization Organization    @relation(fields: [organizationId], references: [id])
  tier         CustomerTier    @relation(fields: [tierId], references: [id])
  salesTeam    SalesTeam?      @relation(fields: [salesTeamId], references: [id])
  contacts     CustomerContact[]
  quotes       Quote[]
  orders       Order[]

  @@index([organizationId, tierId])
  @@map("customer_accounts")
}

model CustomerContact {
  id                String   @id @default(cuid())
  organizationId    String   @map("organization_id")
  customerAccountId String   @map("customer_account_id")
  email             String
  firstName         String   @map("first_name")
  lastName          String   @map("last_name")
  isPrimary         Boolean  @default(false) @map("is_primary")
  portalEnabled     Boolean  @default(false) @map("portal_enabled")
  createdAt         DateTime @default(now()) @map("created_at")
  updatedAt         DateTime @updatedAt @map("updated_at")

  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id])
  portalIdentity  PortalIdentity?

  @@unique([organizationId, customerAccountId, email])
  @@map("customer_contacts")
}

model ProductCategory {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization   Organization    @relation(fields: [organizationId], references: [id])
  products       Product[]
  priceRules     PriceRule[]
  discountLimits DiscountLimit[]

  @@unique([organizationId, code])
  @@map("product_categories")
}

model Product {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  categoryId     String      @map("category_id")
  name           String
  code           String
  type           ProductType
  description    String?
  unit           String      @default("each")
  standardCost   Decimal     @map("standard_cost") @db.Decimal(19, 4)
  taxId          String?     @map("tax_id")
  active         Boolean     @default(true)
  revision       Int         @default(0)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization        Organization         @relation(fields: [organizationId], references: [id])
  category            ProductCategory      @relation(fields: [categoryId], references: [id])
  tax                 Tax?                 @relation(fields: [taxId], references: [id])
  variants            ProductVariant[]
  priceRules          PriceRule[]
  discountLimits      DiscountLimit[]
  quoteLines          QuoteLine[]
  orderLines          OrderLine[]
  inventoryBalances   InventoryBalance[]
  productAffinitiesFrom ProductAffinity[]  @relation("AffinitySource")
  productAffinitiesTo   ProductAffinity[]  @relation("AffinityTarget")
  recommendationRules RecommendationRule[]

  @@unique([organizationId, code])
  @@index([organizationId, type, active])
  @@map("products")
}

model ProductVariant {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  productId      String   @map("product_id")
  sku            String
  name           String?
  attributes     Json     @default("{}")
  priceSurcharge Decimal  @default(0) @map("price_surcharge") @db.Decimal(19, 4)
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  product           Product           @relation(fields: [productId], references: [id])
  quoteLines        QuoteLine[]
  orderLines        OrderLine[]
  inventoryBalances InventoryBalance[]

  @@unique([organizationId, sku])
  @@map("product_variants")
}

model Tax {
  id             String      @id @default(cuid())
  organizationId String      @map("organization_id")
  name           String
  rate           Decimal     @db.Decimal(19, 4)
  behavior       TaxBehavior @default(EXCLUSIVE)
  effectiveFrom  DateTime    @map("effective_from")
  effectiveTo    DateTime?   @map("effective_to")
  active         Boolean     @default(true)
  createdAt      DateTime    @default(now()) @map("created_at")
  updatedAt      DateTime    @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  products     Product[]

  @@index([organizationId, effectiveFrom, effectiveTo])
  @@map("taxes")
}

model PriceList {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  currency       String   @default("USD")
  effectiveFrom  DateTime @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  active         Boolean  @default(true)
  priority       Int      @default(0)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])
  priceRules   PriceRule[]

  @@index([organizationId, active, effectiveFrom])
  @@map("price_lists")
}

model PriceRule {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  priceListId    String   @map("price_list_id")
  productId      String?  @map("product_id")
  categoryId     String?  @map("category_id")
  tierId         String?  @map("tier_id")
  minQuantity    Decimal  @default(1) @map("min_quantity") @db.Decimal(19, 4)
  unitPrice      Decimal  @map("unit_price") @db.Decimal(19, 4)
  priority       Int      @default(0)
  effectiveFrom  DateTime @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  priceList PriceList       @relation(fields: [priceListId], references: [id])
  product   Product?        @relation(fields: [productId], references: [id])
  category  ProductCategory? @relation(fields: [categoryId], references: [id])
  tier      CustomerTier?   @relation(fields: [tierId], references: [id])

  @@index([priceListId, productId, categoryId, tierId])
  @@map("price_rules")
}

model Promotion {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  code           String
  boostScore     Decimal  @default(0) @map("boost_score") @db.Decimal(19, 4)
  priority       Int      @default(0)
  effectiveFrom  DateTime @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization @relation(fields: [organizationId], references: [id])

  @@unique([organizationId, code])
  @@map("promotions")
}

model SubscriptionPlan {
  id                  String              @id @default(cuid())
  organizationId      String              @map("organization_id")
  name                String
  code                String
  interval            SubscriptionInterval
  intervalCount       Int                 @default(1) @map("interval_count")
  prorationConvention ProrationConvention @default(CALENDAR_DAYS) @map("proration_convention")
  cancellationRules   Json                @default("{}") @map("cancellation_rules")
  active              Boolean             @default(true)
  createdAt           DateTime            @default(now()) @map("created_at")
  updatedAt           DateTime            @updatedAt @map("updated_at")

  organization     Organization      @relation(fields: [organizationId], references: [id])
  quoteLines       QuoteLine[]
  subscriptionItems SubscriptionItem[]

  @@unique([organizationId, code])
  @@map("subscription_plans")
}

// ─── Quotation & Governance ──────────────────────────────────────────────────

model DiscountLimit {
  id             String   @id @default(cuid())
  organizationId String   @map("organization_id")
  name           String
  tierId         String?  @map("tier_id")
  categoryId     String?  @map("category_id")
  productId      String?  @map("product_id")
  maxDiscountPct Decimal  @map("max_discount_pct") @db.Decimal(19, 4)
  priority       Int      @default(0)
  effectiveFrom  DateTime @map("effective_from")
  effectiveTo    DateTime? @map("effective_to")
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at")
  updatedAt      DateTime @updatedAt @map("updated_at")

  organization Organization     @relation(fields: [organizationId], references: [id])
  tier         CustomerTier?    @relation(fields: [tierId], references: [id])
  category     ProductCategory? @relation(fields: [categoryId], references: [id])
  product      Product?         @relation(fields: [productId], references: [id])

  @@index([organizationId, tierId, categoryId, productId])
  @@map("discount_limits")
}

model Quote {
  id               String     @id @default(cuid())
  organizationId   String     @map("organization_id")
  customerAccountId String    @map("customer_account_id")
  ownerId          String     @map("owner_id")
  quoteNumber      String     @map("quote_number")
  stage            QuoteStage @default(DRAFT)
  currentVersionId String?    @unique @map("current_version_id")
  expiresAt        DateTime?  @map("expires_at")
  revision         Int        @default(0)
  createdAt        DateTime   @default(now()) @map("created_at")
  updatedAt        DateTime   @updatedAt @map("updated_at")

  organization    Organization       @relation(fields: [organizationId], references: [id])
  customerAccount CustomerAccount    @relation(fields: [customerAccountId], references: [id])
  owner           User               @relation("QuoteOwner", fields: [ownerId], references: [id])
  currentVersion  QuoteVersion?      @relation("CurrentVersion", fields: [currentVersionId], references: [id])
  versions        QuoteVersion[]     @relation("QuoteVersions")
  negotiationThreads NegotiationThread[]
  magicLinkTokens MagicLinkToken[]
  recommendationInteractions RecommendationInteraction[]
  orders          Order[]
  dealEvents      DealEvent[]

  @@unique([organizationId, quoteNumber])
  @@index([organizationId, stage, ownerId])
  @@index([organizationId, updatedAt])
  @@map("quotes")
}

model QuoteVersion {
  id               String             @id @default(cuid())
  organizationId   String             @map("organization_id")
  quoteId          String             @map("quote_id")
  revisionNumber   Int                @map("revision_number")
  status           QuoteVersionStatus @default(DRAFT)
  currency         String             @default("USD")
  subtotal         Decimal            @default(0) @db.Decimal(19, 4)
  taxTotal         Decimal            @default(0) @map("tax_total") @db.Decimal(19, 4)
  discountTotal    Decimal            @default(0) @map("discount_total") @db.Decimal(19, 4)
  total            Decimal            @default(0) @db.Decimal(19, 4)
  costTotal        Decimal            @default(0) @map("cost_total") @db.Decimal(19, 4)
  grossMargin      Decimal            @default(0) @map("gross_margin") @db.Decimal(19, 4)
  marginPercent    Decimal            @default(0) @map("margin_percent") @db.Decimal(19, 4)
  riskFacts        Json               @default("{}") @map("risk_facts")
  policyVersion    String?            @map("policy_version")
  termsFingerprint String             @map("terms_fingerprint")
  paymentTermsDays Int                @default(30) @map("payment_terms_days")
  notes            String?
  createdAt        DateTime           @default(now()) @map("created_at")

  quote            Quote              @relation("QuoteVersions", fields: [quoteId], references: [id])
  currentForQuote  Quote?             @relation("CurrentVersion")
  lines            QuoteLine[]
  approvalRequests ApprovalRequest[]
  changeRequests   ChangeRequest[]

  @@unique([quoteId, revisionNumber])
  @@index([organizationId, status])
  @@map("quote_versions")
}

model QuoteLine {
  id                 String      @id @default(cuid())
  organizationId     String      @map("organization_id")
  quoteVersionId     String      @map("quote_version_id")
  productId          String      @map("product_id")
  variantId          String?     @map("variant_id")
  lineNumber         Int         @map("line_number")
  productName        String      @map("product_name")
  productType        ProductType @map("product_type")
  sku                String?
  quantity           Decimal     @db.Decimal(19, 4)
  unitPrice          Decimal     @map("unit_price") @db.Decimal(19, 4)
  unitCost           Decimal     @map("unit_cost") @db.Decimal(19, 4)
  discountPercent    Decimal     @default(0) @map("discount_percent") @db.Decimal(19, 4)
  discountAmount     Decimal     @default(0) @map("discount_amount") @db.Decimal(19, 4)
  taxRate            Decimal     @default(0) @map("tax_rate") @db.Decimal(19, 4)
  taxAmount          Decimal     @default(0) @map("tax_amount") @db.Decimal(19, 4)
  lineTotal          Decimal     @default(0) @map("line_total") @db.Decimal(19, 4)
  billingType        BillingType @default(ONE_TIME) @map("billing_type")
  subscriptionPlanId String?     @map("subscription_plan_id")
  riskContribution   Json        @default("{}") @map("risk_contribution")
  createdAt          DateTime    @default(now()) @map("created_at")

  quoteVersion     QuoteVersion      @relation(fields: [quoteVersionId], references: [id], onDelete: Cascade)
  product          Product           @relation(fields: [productId], references: [id])
  variant          ProductVariant?   @relation(fields: [variantId], references: [id])
  subscriptionPlan SubscriptionPlan? @relation(fields: [subscriptionPlanId], references: [id])
  orderLines       OrderLine[]
  fulfillmentAllocations FulfillmentAllocation[]
  backorders       Backorder[]

  @@index([quoteVersionId, lineNumber])
  @@map("quote_lines")
}

model ApprovalPolicy {
  id             String       @id @default(cuid())
  organizationId String       @map("organization_id")
  name           String
  version        Int          @default(1)
  status         PolicyStatus @default(ACTIVE)
  predicates     Json         @default("{}")
  priority       Int          @default(0)
  effectiveFrom  DateTime     @map("effective_from")
  effectiveTo    DateTime?    @map("effective_to")
