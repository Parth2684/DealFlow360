}

model DealHealthSnapshot {
  id                      String   @id @default(uuid()) @db.Uuid
  organizationId          String   @map("organization_id") @db.Uuid
  quoteId                 String?  @map("quote_id") @db.Uuid
  reason                  String   @db.VarChar(160)
  healthScore             Decimal  @map("health_score") @db.Decimal(19, 4)
  stalledDays             Int      @default(0) @map("stalled_days")
  discountAnomalyScore    Decimal  @default(0) @map("discount_anomaly_score") @db.Decimal(19, 4)
  approvalSlaHoursOverdue Int      @default(0) @map("approval_sla_hours_overdue")
  promiseSlippageDays     Int      @default(0) @map("promise_slippage_days")
  creditExposure          Decimal  @default(0) @map("credit_exposure") @db.Decimal(19, 4)
  facts                   Json     @default("{}")
  calculatedAt            DateTime @default(now()) @map("calculated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quote        Quote?       @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  alerts       Alert[]

  @@index([organizationId, quoteId, calculatedAt])
  @@index([organizationId, calculatedAt])
  @@map("deal_health_snapshots")
}

model Alert {
  id                   String        @id @default(uuid()) @db.Uuid
  organizationId       String        @map("organization_id") @db.Uuid
  quoteId              String?       @map("quote_id") @db.Uuid
  dealHealthSnapshotId String?       @map("deal_health_snapshot_id") @db.Uuid
  type                 AlertType
  severity             AlertSeverity @default(INFO)
  status               AlertStatus   @default(OPEN)
  reasonCode           String        @map("reason_code") @db.VarChar(100)
  title                String        @db.VarChar(180)
  message              String
  facts                Json          @default("{}")
  acknowledgedById     String?       @map("acknowledged_by_id") @db.Uuid
  acknowledgedAt       DateTime?     @map("acknowledged_at") @db.Timestamptz(3)
  snoozedUntil         DateTime?     @map("snoozed_until") @db.Timestamptz(3)
  resolvedAt           DateTime?     @map("resolved_at") @db.Timestamptz(3)
  detectedAt           DateTime      @default(now()) @map("detected_at") @db.Timestamptz(3)
  revision             Int           @default(1)
  createdAt            DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime      @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  quote              Quote?              @relation(fields: [quoteId], references: [id], onDelete: Restrict)
  dealHealthSnapshot DealHealthSnapshot? @relation(fields: [dealHealthSnapshotId], references: [id], onDelete: Restrict)
  acknowledgedBy     User?               @relation("AlertAcknowledger", fields: [acknowledgedById], references: [id], onDelete: Restrict)
  nudges             Nudge[]

  @@index([organizationId, status, type, detectedAt])
  @@index([organizationId, quoteId, status])
  @@index([organizationId, snoozedUntil])
  @@map("alerts")
}

model Nudge {
  id                 String       @id @default(uuid()) @db.Uuid
  organizationId     String       @map("organization_id") @db.Uuid
  alertId            String       @map("alert_id") @db.Uuid
  requestedById      String       @map("requested_by_id") @db.Uuid
  recipientUserId    String?      @map("recipient_user_id") @db.Uuid
  recipientContactId String?      @map("recipient_contact_id") @db.Uuid
  channel            NudgeChannel
  message            String
  status             NudgeStatus  @default(QUEUED)
  errorMessage       String?      @map("error_message") @db.VarChar(1000)
  requestedAt        DateTime     @default(now()) @map("requested_at") @db.Timestamptz(3)
  sentAt             DateTime?    @map("sent_at") @db.Timestamptz(3)
  failedAt           DateTime?    @map("failed_at") @db.Timestamptz(3)

  organization     Organization     @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  alert            Alert            @relation(fields: [alertId], references: [id], onDelete: Restrict)
  requestedBy      User             @relation("NudgeRequester", fields: [requestedById], references: [id], onDelete: Restrict)
  recipientUser    User?            @relation("NudgeRecipientUser", fields: [recipientUserId], references: [id], onDelete: Restrict)
  recipientContact CustomerContact? @relation("NudgeRecipientContact", fields: [recipientContactId], references: [id], onDelete: Restrict)

  @@index([organizationId, alertId, status])
  @@index([organizationId, status, requestedAt])
  @@map("nudges")
}

model AuditEvent {
  id               String    @id @default(uuid()) @db.Uuid
  organizationId   String    @map("organization_id") @db.Uuid
  actorType        ActorType @map("actor_type")
  actorId          String?   @map("actor_id") @db.Uuid
  actorName        String?   @map("actor_name") @db.VarChar(200)
  entityType       String    @map("entity_type") @db.VarChar(100)
  entityId         String    @map("entity_id") @db.Uuid
  entityVersion    Int?      @map("entity_version")
  termsFingerprint String?   @map("terms_fingerprint") @db.VarChar(64)
  eventType        String    @map("event_type") @db.VarChar(120)
  reason           String?   @db.VarChar(1000)
  beforeSummary    Json?     @map("before_summary")
  afterSummary     Json?     @map("after_summary")
  metadata         Json      @default("{}")
  occurredAt       DateTime  @default(now()) @map("occurred_at") @db.Timestamptz(3)

