model ExportArtifact {
  exportJobId    String   @id @map("export_job_id") @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  content        Bytes
  contentType    String   @map("content_type") @db.VarChar(160)
  filename       String   @db.VarChar(255)
  rowCount       Int      @map("row_count")
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  exportJob    ExportJob    @relation(fields: [exportJobId, organizationId], references: [id, organizationId], onDelete: Cascade)
  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([exportJobId, organizationId])
  @@index([organizationId, createdAt])
  @@map("export_artifacts")
}

model Notification {
