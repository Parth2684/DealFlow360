  @@unique([organizationId, invoiceId, position])
  @@map("invoice_lines")
}

model CreditNote {
  id                   String           @id @default(uuid()) @db.Uuid
  organizationId       String           @map("organization_id") @db.Uuid
  sourceInvoiceId      String           @map("source_invoice_id") @db.Uuid
  appliedInvoiceId     String?          @map("applied_invoice_id") @db.Uuid
  subscriptionChangeId String?          @map("subscription_change_id") @db.Uuid
  creditNoteNumber     String           @map("credit_note_number") @db.VarChar(40)
  status               CreditNoteStatus @default(DRAFT)
  currency             String           @db.VarChar(3)
  subtotal             Decimal          @default(0) @db.Decimal(19, 4)
  taxAmount            Decimal          @default(0) @map("tax_amount") @db.Decimal(19, 4)
  total                Decimal          @default(0) @db.Decimal(19, 4)
  reason               String?          @db.VarChar(1000)
  issuedAt             DateTime?        @map("issued_at") @db.Timestamptz(3)
  appliedAt            DateTime?        @map("applied_at") @db.Timestamptz(3)
  createdAt            DateTime         @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt            DateTime         @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  sourceInvoice      Invoice             @relation("CreditNoteSourceInvoice", fields: [sourceInvoiceId], references: [id], onDelete: Restrict)
  appliedInvoice     Invoice?            @relation("CreditNoteAppliedInvoice", fields: [appliedInvoiceId], references: [id], onDelete: Restrict)
  subscriptionChange SubscriptionChange? @relation(fields: [subscriptionChangeId], references: [id], onDelete: Restrict)
  lines              CreditNoteLine[]

  @@unique([organizationId, creditNoteNumber])
  @@index([organizationId, sourceInvoiceId, status])
  @@map("credit_notes")
}

model CreditNoteLine {
  id                   String   @id @default(uuid()) @db.Uuid
  organizationId       String   @map("organization_id") @db.Uuid
  creditNoteId         String   @map("credit_note_id") @db.Uuid
  sourceInvoiceLineId  String?  @map("source_invoice_line_id") @db.Uuid
  subscriptionChangeId String?  @map("subscription_change_id") @db.Uuid
  position             Int
  description          String   @db.VarChar(500)
  quantity             Decimal  @db.Decimal(19, 4)
  unitAmount           Decimal  @map("unit_amount") @db.Decimal(19, 4)
  taxAmount            Decimal  @default(0) @map("tax_amount") @db.Decimal(19, 4)
  total                Decimal  @db.Decimal(19, 4)
  createdAt            DateTime @default(now()) @map("created_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  creditNote         CreditNote          @relation(fields: [creditNoteId], references: [id], onDelete: Restrict)
  sourceInvoiceLine  InvoiceLine?        @relation(fields: [sourceInvoiceLineId], references: [id], onDelete: Restrict)
  subscriptionChange SubscriptionChange? @relation(fields: [subscriptionChangeId], references: [id], onDelete: Restrict)

  @@unique([organizationId, creditNoteId, position])
  @@map("credit_note_lines")
}

model Payment {
  id             String        @id @default(uuid()) @db.Uuid
  organizationId String        @map("organization_id") @db.Uuid
  invoiceId      String        @map("invoice_id") @db.Uuid
  recordedById   String        @map("recorded_by_id") @db.Uuid
  amount         Decimal       @db.Decimal(19, 4)
  currency       String        @db.VarChar(3)
  method         PaymentMethod
  reference      String?       @db.VarChar(160)
  status         PaymentStatus @default(RECORDED)
  paymentDate    DateTime      @map("payment_date") @db.Timestamptz(3)
  createdAt      DateTime      @default(now()) @map("created_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  invoice      Invoice      @relation(fields: [invoiceId], references: [id], onDelete: Restrict)
  recordedBy   User         @relation("PaymentRecorder", fields: [recordedById], references: [id], onDelete: Restrict)

  @@index([organizationId, invoiceId, paymentDate])
  @@index([organizationId, status, paymentDate])
