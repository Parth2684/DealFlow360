generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
  runtime  = "bun"
}

datasource db {
  provider = "postgresql"
}

enum Role {
  ADMIN
  SALES_REP
  SALES_MANAGER
  FINANCE
  OPERATIONS
  CUSTOMER
}

enum UserStatus {
  INVITED
  ACTIVE
  SUSPENDED
  DISABLED
}

enum PortalIdentityStatus {
  ACTIVE
  DISABLED
}

enum MagicLinkScope {
  CUSTOMER
  QUOTE
}

enum ConfigurationStatus {
  DRAFT
  ACTIVE
  ARCHIVED
}

enum ProductType {
  HARDWARE
  SERVICE
  SUBSCRIPTION
}

enum BillingType {
  ONE_TIME
  RECURRING
}

enum TaxBehavior {
  INCLUSIVE
  EXCLUSIVE
}

enum BillingInterval {
  DAY
  WEEK
  MONTH
  YEAR
}

enum ProrationConvention {
  CALENDAR_DAYS
  THIRTY_DAY_MONTH
}

enum QuoteStage {
  DRAFT
  PENDING_APPROVAL
  REVISION_REQUIRED
  READY_TO_SEND
  SENT
  UNDER_NEGOTIATION
  CUSTOMER_ACCEPTED
  CONFIRMED
  EXPIRED
  CANCELLED
}

enum QuoteVersionStatus {
  DRAFT
  PENDING_APPROVAL
  REVISION_REQUIRED
  READY_TO_SEND
  APPROVED
  REJECTED
  CUSTOMER_ACCEPTED
  SUPERSEDED
}

enum ApprovalRequestStatus {
  PENDING
  IN_PROGRESS
  APPROVED
  REJECTED
  REVISION_REQUIRED
  SUPERSEDED
}

enum ApprovalStepStatus {
  WAITING
  ACTIVE
  APPROVED
  REJECTED
  REVISION_REQUIRED
  SKIPPED
  SUPERSEDED
}

enum ApprovalDecisionAction {
  APPROVE
  REJECT
  REQUEST_REVISION
}

enum RecommendationInteractionType {
  IMPRESSION
  DISMISSAL
  ACCEPTANCE
}

enum NegotiationThreadStatus {
  OPEN
  CLOSED
}

enum Visibility {
  INTERNAL
  CUSTOMER
  BOTH
}

enum ActorType {
  USER
  PORTAL
  SYSTEM
}

enum ChangeRequestStatus {
  PENDING
  COUNTERED
  ACCEPTED
  REJECTED
  SUPERSEDED
}

enum ChangeRequestAction {
  REMOVE
  CHANGE_QUANTITY
  CHANGE_PRICE
  CHANGE_DISCOUNT
  CHANGE_TERMS
}

enum CounterofferStatus {
  PENDING
  ACCEPTED
  REJECTED
  SUPERSEDED
  EXPIRED
}

enum OrderStatus {
  CONFIRMED
  ALLOCATION_PENDING
  RESERVED
  PARTIALLY_FULFILLED
  FULFILLED
  CANCELLED
}

enum StockMovementType {
  RECEIPT
  RESERVATION
  RELEASE
  SHIPMENT
  ADJUSTMENT
}

enum StockReservationStatus {
  ACTIVE
  RELEASED
  SHIPPED
  CANCELLED
}

enum FulfillmentPlanStatus {
  PREVIEW
  ACCEPTED
  SUPERSEDED
  EXPIRED
}

enum FulfillmentPlanSource {
  RECOMMENDED
  MANUAL
}

enum ShipmentStatus {
  PLANNED
  READY
  SHIPPED
  DELIVERED
  CANCELLED
}

enum BackorderStatus {
  OPEN
  PARTIALLY_ALLOCATED
  CONSOLIDATED
  FULFILLED
  CANCELLED
}

enum SubscriptionStatus {
  PENDING
  ACTIVE
  CHANGE_SCHEDULED
  CANCELLATION_SCHEDULED
  CANCELLED
  EXPIRED
}

enum SubscriptionChangeType {
  QUANTITY_CHANGE
  PLAN_CHANGE
  CANCELLATION
}

enum ProrationDirection {
  DEBIT
  CREDIT
  NONE
}

enum SubscriptionChangeStatus {
  APPLIED
  REVERSED
}

enum BillingScheduleStatus {
  PENDING
  GENERATED
  SKIPPED
  CANCELLED
  FAILED
}

enum InvoiceType {
  ONE_TIME
  RECURRING
  PRORATION
}

enum InvoiceStatus {
  DRAFT
  ISSUED
  PARTIALLY_PAID
  PAID
  OVERDUE
  VOID
}

enum CreditNoteStatus {
  DRAFT
  ISSUED
  APPLIED
  VOID
}

enum PaymentMethod {
  BANK_TRANSFER
  CREDIT_CARD
  CHECK
  OTHER
}

enum PaymentStatus {
  RECORDED
  REVERSED
  FAILED
}

enum AlertType {
  STALLED_DEAL
  DISCOUNT_ANOMALY
  APPROVAL_SLA
  PROMISE_SLIPPAGE
  CREDIT_EXPOSURE
}

enum AlertSeverity {
  INFO
  WARNING
  CRITICAL
}

enum AlertStatus {
  OPEN
  ACKNOWLEDGED
  SNOOZED
  RESOLVED
}

enum NudgeChannel {
  IN_APP
  EMAIL
}

enum NudgeStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

enum OutboxEventStatus {
  PENDING
  PROCESSING
  PROCESSED
  FAILED
  DEAD_LETTER
}

enum IdempotencyStatus {
  IN_PROGRESS
  COMPLETED
  FAILED
}

enum ReportType {
  QUOTES
  ORDERS
  INVOICES
  CUSTOMERS
  INVENTORY
}

enum ExportFormat {
  CSV
  XLSX
  PDF
}

enum ExportJobStatus {
  QUEUED
  PROCESSING
  COMPLETED
  FAILED
  EXPIRED
  CANCELLED
}

enum NotificationChannel {
  IN_APP
  EMAIL
}

enum NotificationStatus {
  QUEUED
  SENT
  FAILED
  CANCELLED
}

model Organization {
  id           String   @id @default(uuid()) @db.Uuid
  name         String   @db.VarChar(160)
  slug         String   @unique @db.VarChar(80)
  baseCurrency String   @default("USD") @map("base_currency") @db.VarChar(3)
  timezone     String   @default("UTC") @db.VarChar(64)
  settings     Json     @default("{}")
  createdAt    DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt    DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  users                        User[]
  salesTeams                   SalesTeam[]
  roleAssignments              RoleAssignment[]
  sessions                     Session[]
  refreshTokens                RefreshToken[]
  portalSessions               PortalSession[]
  magicLinkTokens              MagicLinkToken[]
  customerTiers                CustomerTier[]
  customerAccounts             CustomerAccount[]
  customerContacts             CustomerContact[]
  portalIdentities             PortalIdentity[]
  productCategories            ProductCategory[]
  taxes                        Tax[]
  products                     Product[]
  productVariants              ProductVariant[]
  priceLists                   PriceList[]
  priceRules                   PriceRule[]
  discountLimits               DiscountLimit[]
  promotions                   Promotion[]
  promotionProducts            PromotionProduct[]
  subscriptionPlans            SubscriptionPlan[]
  quotes                       Quote[]
  quoteVersions                QuoteVersion[]
  quoteLines                   QuoteLine[]
  quoteRiskAssessments         QuoteRiskAssessment[]
  quoteLineRiskFacts           QuoteLineRiskFact[]
  quoteLineRiskLimitMatches    QuoteLineRiskLimitMatch[]
  approvalPolicies             ApprovalPolicy[]
  approvalStepTemplates        ApprovalStepTemplate[]
  approvalRequests             ApprovalRequest[]
  approvalRequestPolicyMatches ApprovalRequestPolicyMatch[]
  approvalSteps                ApprovalStep[]
  approvalDecisions            ApprovalDecision[]
  recommendationRules          RecommendationRule[]
  productAffinities            ProductAffinity[]
  recommendationInteractions   RecommendationInteraction[]
  negotiationThreads           NegotiationThread[]
  negotiationMessages          NegotiationMessage[]
  changeRequests               ChangeRequest[]
  changeRequestItems           ChangeRequestItem[]
  counteroffers                Counteroffer[]
  counterofferItems            CounterofferItem[]
  customerAcceptances          CustomerAcceptance[]
  orders                       Order[]
  orderLines                   OrderLine[]
  warehouses                   Warehouse[]
  inventoryBalances            InventoryBalance[]
  stockMovements               StockMovement[]
  fulfillmentPlans             FulfillmentPlan[]
  fulfillmentAllocations       FulfillmentAllocation[]
  stockReservations            StockReservation[]
  shipments                    Shipment[]
  shipmentItems                ShipmentItem[]
  backorders                   Backorder[]
  subscriptions                Subscription[]
  subscriptionItems            SubscriptionItem[]
  subscriptionChanges          SubscriptionChange[]
  billingSchedules             BillingSchedule[]
  invoices                     Invoice[]
  invoiceLines                 InvoiceLine[]
  creditNotes                  CreditNote[]
  creditNoteLines              CreditNoteLine[]
  payments                     Payment[]
  dealHealthSnapshots          DealHealthSnapshot[]
  alerts                       Alert[]
  nudges                       Nudge[]
  auditEvents                  AuditEvent[]
  dealEvents                   DealEvent[]
  outboxEvents                 OutboxEvent[]
  idempotencyRecords           IdempotencyRecord[]
  exportJobs                   ExportJob[]
  exportArtifacts              ExportArtifact[]
  notifications                Notification[]
  savedReportFilters           SavedReportFilter[]

  @@map("organizations")
}

model User {
  id              String     @id @default(uuid()) @db.Uuid
  organizationId  String     @map("organization_id") @db.Uuid
  email           String     @unique @db.VarChar(254)
  passwordHash    String?    @map("password_hash") @db.VarChar(255)
  firstName       String     @map("first_name") @db.VarChar(100)
  lastName        String     @map("last_name") @db.VarChar(100)
  status          UserStatus @default(INVITED)
  emailVerifiedAt DateTime?  @map("email_verified_at") @db.Timestamptz(3)
  lastLoginAt     DateTime?  @map("last_login_at") @db.Timestamptz(3)
  revision        Int        @default(1)
  createdAt       DateTime   @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt       DateTime   @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization                Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  managedSalesTeams           SalesTeam[]          @relation("SalesTeamManager")
  roleAssignments             RoleAssignment[]
  sessions                    Session[]
  createdQuoteVersions        QuoteVersion[]       @relation("QuoteVersionCreator")
  ownedQuotes                 Quote[]              @relation("QuoteOwner")
  assignedCustomers           CustomerAccount[]    @relation("CustomerAssignedRep")
  assignedApprovalSteps       ApprovalStep[]       @relation("ApprovalStepAssignee")
  delegatedApprovalSteps      ApprovalStep[]       @relation("ApprovalStepDelegate")
  assignedApprovalDelegations ApprovalStep[]       @relation("ApprovalStepDelegateAssigner")
  approvalDecisions           ApprovalDecision[]
  confirmedOrders             Order[]              @relation("OrderConfirmer")
  acceptedFulfillmentPlans    FulfillmentPlan[]    @relation("FulfillmentPlanAcceptor")
  exportJobs                  ExportJob[]
  savedReportFilters          SavedReportFilter[]
  notifications               Notification[]       @relation("NotificationRecipientUser")
  authoredNegotiationMessages NegotiationMessage[] @relation("NegotiationMessageAuthor")
  resolvedChangeRequests      ChangeRequest[]      @relation("ChangeRequestResolver")
  offeredCounteroffers        Counteroffer[]       @relation("CounterofferAuthor")
  ownedOrders                 Order[]              @relation("OrderOwner")
  stockMovements              StockMovement[]      @relation("StockMovementActor")
  subscriptionChanges         SubscriptionChange[] @relation("SubscriptionChangeActor")
  recordedPayments            Payment[]            @relation("PaymentRecorder")
  acknowledgedAlerts          Alert[]              @relation("AlertAcknowledger")
  requestedNudges             Nudge[]              @relation("NudgeRequester")
  recipientNudges             Nudge[]              @relation("NudgeRecipientUser")

  @@index([organizationId, status])
  @@map("users")
}

model SalesTeam {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  name           String              @db.VarChar(120)
  managerId      String?             @map("manager_id") @db.Uuid
  status         ConfigurationStatus @default(ACTIVE)
  revision       Int                 @default(1)
  archivedAt     DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  manager          User?             @relation("SalesTeamManager", fields: [managerId], references: [id], onDelete: SetNull)
  roleAssignments  RoleAssignment[]
  customerAccounts CustomerAccount[]
  quotes           Quote[]

  @@unique([organizationId, name])
  @@index([organizationId, managerId, status])
  @@map("sales_teams")
}

model RoleAssignment {
  id             String   @id @default(uuid()) @db.Uuid
  organizationId String   @map("organization_id") @db.Uuid
  userId         String   @map("user_id") @db.Uuid
  role           Role
  salesTeamId    String?  @map("sales_team_id") @db.Uuid
  active         Boolean  @default(true)
  createdAt      DateTime @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user         User         @relation(fields: [userId], references: [id], onDelete: Restrict)
  salesTeam    SalesTeam?   @relation(fields: [salesTeamId], references: [id], onDelete: Restrict)

  @@unique([organizationId, userId, role, salesTeamId])
  @@index([organizationId, role, active])
  @@map("role_assignments")
}

model Session {
  id             String    @id @default(uuid()) @db.Uuid
  organizationId String    @map("organization_id") @db.Uuid
  userId         String    @map("user_id") @db.Uuid
  tokenHash      String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt      DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt      DateTime? @map("revoked_at") @db.Timestamptz(3)
  lastSeenAt     DateTime? @map("last_seen_at") @db.Timestamptz(3)
  metadata       Json      @default("{}")
  createdAt      DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization  Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  user          User           @relation(fields: [userId], references: [id], onDelete: Restrict)
  refreshTokens RefreshToken[]

  @@index([organizationId, userId, expiresAt])
  @@index([expiresAt, revokedAt])
  @@map("sessions")
}

model RefreshToken {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  sessionId         String    @map("session_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(128)
  familyId          String    @map("family_id") @db.Uuid
  replacedByTokenId String?   @map("replaced_by_token_id") @db.Uuid
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization   @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  session         Session        @relation(fields: [sessionId], references: [id], onDelete: Restrict)
  replacedByToken RefreshToken?  @relation("RefreshTokenRotation", fields: [replacedByTokenId], references: [id], onDelete: Restrict)
  replacesTokens  RefreshToken[] @relation("RefreshTokenRotation")

  @@index([organizationId, sessionId, expiresAt])
  @@index([familyId])
  @@map("refresh_tokens")
}

model CustomerTier {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  name           String              @db.VarChar(80)
  code           String              @db.VarChar(40)
  priority       Int                 @default(0)
  status         ConfigurationStatus @default(ACTIVE)
  archivedAt     DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization     Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerAccounts CustomerAccount[]
  priceRules       PriceRule[]
  discountLimits   DiscountLimit[]

  @@unique([organizationId, code])
  @@index([organizationId, status, priority])
  @@map("customer_tiers")
}

model CustomerAccount {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  tierId            String              @map("tier_id") @db.Uuid
  salesTeamId       String?             @map("sales_team_id") @db.Uuid
  assignedRepId     String?             @map("assigned_rep_id") @db.Uuid
  accountCode       String              @map("account_code") @db.VarChar(40)
  name              String              @db.VarChar(180)
  preferredCurrency String              @default("USD") @map("preferred_currency") @db.VarChar(3)
  paymentTermsDays  Int                 @default(30) @map("payment_terms_days")
  creditLimit       Decimal             @default(0) @map("credit_limit") @db.Decimal(19, 4)
  currentExposure   Decimal             @default(0) @map("current_exposure") @db.Decimal(19, 4)
  overdueBalance    Decimal             @default(0) @map("overdue_balance") @db.Decimal(19, 4)
  status            ConfigurationStatus @default(ACTIVE)
  revision          Int                 @default(1)
  archivedAt        DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization       Organization        @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  tier               CustomerTier        @relation(fields: [tierId], references: [id], onDelete: Restrict)
  salesTeam          SalesTeam?          @relation(fields: [salesTeamId], references: [id], onDelete: Restrict)
  assignedRep        User?               @relation("CustomerAssignedRep", fields: [assignedRepId], references: [id], onDelete: Restrict)
  contacts           CustomerContact[]
  magicLinkTokens    MagicLinkToken[]
  portalSessions     PortalSession[]
  quotes             Quote[]             @relation("QuoteCustomer")
  quoteVersions      QuoteVersion[]      @relation("QuoteVersionCustomer")
  negotiationThreads NegotiationThread[]
  orders             Order[]
  subscriptions      Subscription[]
  invoices           Invoice[]

  @@unique([organizationId, accountCode])
  @@index([organizationId, tierId, status])
  @@index([organizationId, salesTeamId, assignedRepId, status])
  @@map("customer_accounts")
}

model CustomerContact {
  id                String              @id @default(uuid()) @db.Uuid
  organizationId    String              @map("organization_id") @db.Uuid
  customerAccountId String              @map("customer_account_id") @db.Uuid
  email             String              @db.VarChar(254)
  firstName         String              @map("first_name") @db.VarChar(100)
  lastName          String              @map("last_name") @db.VarChar(100)
  isPrimary         Boolean             @default(false) @map("is_primary")
  portalEnabled     Boolean             @default(false) @map("portal_enabled")
  status            ConfigurationStatus @default(ACTIVE)
  createdAt         DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  portalIdentity  PortalIdentity?
  recipientNudges Nudge[]         @relation("NudgeRecipientContact")

  @@unique([organizationId, customerAccountId, email])
  @@index([organizationId, customerAccountId, status])
  @@map("customer_contacts")
}

model PortalIdentity {
  id                String               @id @default(uuid()) @db.Uuid
  organizationId    String               @map("organization_id") @db.Uuid
  customerContactId String               @unique @map("customer_contact_id") @db.Uuid
  email             String               @db.VarChar(254)
  status            PortalIdentityStatus @default(ACTIVE)
  lastLoginAt       DateTime?            @map("last_login_at") @db.Timestamptz(3)
  createdAt         DateTime             @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt         DateTime             @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization          Organization         @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  customerContact       CustomerContact      @relation(fields: [customerContactId], references: [id], onDelete: Restrict)
  magicLinkTokens       MagicLinkToken[]
  portalSessions        PortalSession[]
  negotiationMessages   NegotiationMessage[]
  changeRequests        ChangeRequest[]
  counterofferDecisions Counteroffer[]       @relation("CounterofferCustomerDecision")
  customerAcceptances   CustomerAcceptance[]
  notifications         Notification[]       @relation("NotificationRecipientPortal")

  @@unique([organizationId, email])
  @@index([organizationId, status])
  @@map("portal_identities")
}

model PortalSession {
  id                String    @id @default(uuid()) @db.Uuid
  organizationId    String    @map("organization_id") @db.Uuid
  portalIdentityId  String    @map("portal_identity_id") @db.Uuid
  customerAccountId String    @map("customer_account_id") @db.Uuid
  quoteId           String?   @map("quote_id") @db.Uuid
  tokenHash         String    @unique @map("token_hash") @db.VarChar(128)
  expiresAt         DateTime  @map("expires_at") @db.Timestamptz(3)
  revokedAt         DateTime? @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime  @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  portalIdentity  PortalIdentity  @relation(fields: [portalIdentityId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  quote           Quote?          @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([organizationId, portalIdentityId, expiresAt])
  @@index([organizationId, customerAccountId, quoteId])
  @@map("portal_sessions")
}

model MagicLinkToken {
  id                String         @id @default(uuid()) @db.Uuid
  organizationId    String         @map("organization_id") @db.Uuid
  portalIdentityId  String         @map("portal_identity_id") @db.Uuid
  customerAccountId String         @map("customer_account_id") @db.Uuid
  quoteId           String?        @map("quote_id") @db.Uuid
  tokenHash         String         @unique @map("token_hash") @db.VarChar(128)
  scope             MagicLinkScope
  maxUses           Int            @default(1) @map("max_uses")
  useCount          Int            @default(0) @map("use_count")
  expiresAt         DateTime       @map("expires_at") @db.Timestamptz(3)
  usedAt            DateTime?      @map("used_at") @db.Timestamptz(3)
  revokedAt         DateTime?      @map("revoked_at") @db.Timestamptz(3)
  createdAt         DateTime       @default(now()) @map("created_at") @db.Timestamptz(3)

  organization    Organization    @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  portalIdentity  PortalIdentity  @relation(fields: [portalIdentityId], references: [id], onDelete: Restrict)
  customerAccount CustomerAccount @relation(fields: [customerAccountId], references: [id], onDelete: Restrict)
  quote           Quote?          @relation(fields: [quoteId], references: [id], onDelete: Restrict)

  @@index([organizationId, customerAccountId, quoteId, expiresAt, revokedAt])
  @@map("magic_link_tokens")
}

model ProductCategory {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  parentId       String?             @map("parent_id") @db.Uuid
  code           String              @db.VarChar(40)
  name           String              @db.VarChar(120)
  description    String?
  status         ConfigurationStatus @default(ACTIVE)
  revision       Int                 @default(1)
  archivedAt     DateTime?           @map("archived_at") @db.Timestamptz(3)
  createdAt      DateTime            @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt      DateTime            @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization   Organization      @relation(fields: [organizationId], references: [id], onDelete: Restrict)
  parent         ProductCategory?  @relation("ProductCategoryTree", fields: [parentId], references: [id], onDelete: Restrict)
  children       ProductCategory[] @relation("ProductCategoryTree")
  products       Product[]
  priceRules     PriceRule[]
  discountLimits DiscountLimit[]

  @@unique([organizationId, code])
  @@index([organizationId, parentId, status])
  @@map("product_categories")
}

model Tax {
  id             String              @id @default(uuid()) @db.Uuid
  organizationId String              @map("organization_id") @db.Uuid
  code           String              @db.VarChar(40)
  name           String              @db.VarChar(100)
  rate           Decimal             @db.Decimal(19, 4)
  behavior       TaxBehavior         @default(EXCLUSIVE)
  effectiveFrom  DateTime            @map("effective_from") @db.Timestamptz(3)
  effectiveTo    DateTime?           @map("effective_to") @db.Timestamptz(3)
  status         ConfigurationStatus @default(ACTIVE)
  archivedAt     DateTime?           @map("archived_at") @db.Timestamptz(3)
