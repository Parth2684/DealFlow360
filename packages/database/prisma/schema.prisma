model OutboxEvent {
  id               String            @id @default(uuid()) @db.Uuid
  organizationId   String            @map("organization_id") @db.Uuid
  eventType        String            @map("event_type") @db.VarChar(120)
  aggregateType    String            @map("aggregate_type") @db.VarChar(100)
  aggregateId      String            @map("aggregate_id") @db.Uuid
  deduplicationKey String            @map("deduplication_key") @db.VarChar(191)
  payload          Json
  status           OutboxEventStatus @default(PENDING)
  attempts         Int               @default(0)
  maxAttempts      Int               @default(5) @map("max_attempts")
  availableAt      DateTime          @default(now()) @map("available_at") @db.Timestamptz(3)
  lockedAt         DateTime?         @map("locked_at") @db.Timestamptz(3)
  lockedBy         String?           @map("locked_by") @db.VarChar(120)
  processedAt      DateTime?         @map("processed_at") @db.Timestamptz(3)
  lastError        String?           @map("last_error") @db.VarChar(2000)
  createdAt        DateTime          @default(now()) @map("created_at") @db.Timestamptz(3)
  updatedAt        DateTime          @updatedAt @map("updated_at") @db.Timestamptz(3)

  organization Organization @relation(fields: [organizationId], references: [id], onDelete: Restrict)

  @@unique([organizationId, deduplicationKey])
  @@index([status, availableAt])
  @@index([organizationId, aggregateType, aggregateId, createdAt])
  @@map("outbox_events")
}

model IdempotencyRecord {
