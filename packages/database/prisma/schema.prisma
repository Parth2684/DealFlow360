  periodEnd      DateTime              @map("period_end")
  dueDate        DateTime              @map("due_date")
  amount         Decimal               @db.Decimal(19, 4)
  status         BillingScheduleStatus @default(PENDING)
  invoiceId      String?               @unique @map("invoice_id")
  createdAt      DateTime              @default(now()) @map("created_at")

  subscription Subscription @relation(fields: [subscriptionId], references: [id])
  invoice      Invoice?     @relation(fields: [invoiceId], references: [id])

  @@unique([subscriptionId, periodStart, periodEnd])
  @@index([organizationId, dueDate, status])
  @@map("billing_schedules")
}

model Invoice {
  id             String        @id @default(cuid())
  organizationId String        @map("organization_id")
  orderId        String?       @map("order_id")
  subscriptionId String?       @map("subscription_id")
  invoiceNumber  String        @map("invoice_number")
  type           InvoiceType
  status         InvoiceStatus @default(DRAFT)
  currency       String        @default("USD")
  subtotal       Decimal       @default(0) @db.Decimal(19, 4)
