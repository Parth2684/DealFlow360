{
  "extends": ["//"],
  "tasks": {
    "build": {
      "outputs": ["dist/**"]
    },
    "build:styles": {
      "outputs": ["dist/index.css"]
    },
    "build:components": {
      "outputs": ["dist/**/*.d.ts", "dist/**/*.d.ts.map", "dist/**/*.js"]
    },
    "dev": {
      "with": ["dev:styles", "dev:components"]
    },
    "dev:styles": {
      "cache": false,
      "persistent": true
    },
    "dev:components": {
      "cache": false,
      "persistent": true
    }
  }
}
