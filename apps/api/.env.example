DATABASE_URL=postgresql://USER:PASSWORD@HOST:5432/DATABASE
DATABASE_SCHEMA=dealflow360
PORT=3000
API_PUBLIC_URL=http://localhost:3000
WEB_ORIGIN=http://localhost:3001
SESSION_TTL_HOURS=8
REFRESH_TTL_DAYS=14
PORTAL_SESSION_TTL_MINUTES=60
MAGIC_LINK_TTL_MINUTES=15
COOKIE_SECURE=false
WORKER_POLL_INTERVAL_MS=2000
WORKER_BATCH_SIZE=20
WORKER_BILLING_INTERVAL_MS=60000
WORKER_INVOICE_INTERVAL_MS=60000
WORKER_HEALTH_INTERVAL_MS=300000
WORKER_APPROVAL_INTERVAL_MS=60000
WORKER_BACKORDER_INTERVAL_MS=60000
WORKER_CLEANUP_INTERVAL_MS=60000
APPROVAL_ESCALATION_AFTER_HOURS=24

# Nodemailer SMTP: Gmail defaults require only SMTP_USER and SMTP_PASS.
# For Gmail use an app password, not your normal account password.
SMTP_USER=
SMTP_PASS=
# Optional overrides for other providers:
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=465
# SMTP_FROM=DealFlow360 <your-address@gmail.com>
# Default organization for the public customer request form (no slug entry needed).
PORTAL_ORGANIZATION_SLUG=dealflow360-demo
